# Primed Real Estate — environment variables
# Copy to .env.local (development) or set in your host's dashboard (production).
# Never commit real values. Names only here; no secrets.

# ---- Environment ----------------------------------------------------------
# "production" only on the live site. Any other value = preview: noindex everywhere,
# robots.txt blocks crawling, leads are flagged as tests and nothing is sent externally.
SITE_ENV=preview

# Public https URL of the live site, no trailing slash (e.g. https://www.yourdomain.com).
# Leave unset until the real domain is connected: canonicals, sitemap entries and
# structured data are only emitted when this is set AND SITE_ENV=production.
NEXT_PUBLIC_SITE_URL=

# ---- Owner access ---------------------------------------------------------
# Create the hash with:  npm run hash-password -- "a long passphrase"
# Format: scrypt:<salt>:<hash>
ADMIN_PASSWORD_HASH=
# 32+ random characters, e.g. from:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Storage ----------------------------------------------------------------
# SQLite database file and public upload folder. Must be on a persistent disk.
DATABASE_PATH=data/primed.db
UPLOAD_DIR=data/uploads

# ---- Leads ------------------------------------------------------------------
# Keep "true" until launch. Set "false" (with SITE_ENV=production) to allow CRM delivery.
LEADS_TEST_MODE=true

# Optional: any CRM or automation tool that accepts JSON webhooks.
# Payloads are signed with HMAC-SHA256 in the x-primed-signature header.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ---- Calculator -------------------------------------------------------------
# Preview only: lets the calculator demonstrate itself with the documented TEST fixture.
# Ignored when SITE_ENV=production. Real estimates use the owner's versions in /admin/estimator.
ESTIMATOR_PREVIEW_FIXTURE=false

# ---- Analytics (optional) --------------------------------------------------
# none | plausible | ga4. For plausible, the ID is your site domain; for ga4, the measurement ID.
# GA4 loads only after the visitor accepts the analytics prompt.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_ID=

# ---- Optional fallbacks (owner settings in /admin/settings take precedence) ----
PUBLIC_PHONE=
PUBLIC_EMAIL=
GOOGLE_SITE_VERIFICATION=
